# Clippy v1 — local secrets. Gitignored. Never commit this file.

# ─── Jenova Agent API → KnowBrain (spec §6.3) ────────────────────────────────
# https://www.jenova.ai/platform/api-keys     key format: jnv_sk_*
JENOVA_API_KEY=

# Which agent KnowBrain targets (spec §13). `jenova` is the general-purpose one.
# Run GET /agents against your key to see if a better-suited pre-built agent exists.
JENOVA_AGENT=jenova

# ─── Anthropic → ActBrain (spec §6.3) ────────────────────────────────────────
# https://console.anthropic.com/settings/keys   key format: sk-ant-*
# Alternative: install the `ant` CLI, run `ant auth login`, and leave this blank —
# the SDK reads the stored profile automatically with no env var set.
ANTHROPIC_API_KEY=
